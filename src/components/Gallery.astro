---
import ProjectScreenshot from "./ProjectScreenshot.astro"
import type { ProjectImage } from "@/lib/projects"
import type { Locale } from "@/lib/i18n"
interface Props { images: ProjectImage[]; locale: Locale }
const { images, locale } = Astro.props
const [cover, ...rest] = images
---
{cover && <div data-gallery>
  <ProjectScreenshot image={cover} locale={locale} />
  {rest.length > 0 && <details class="mt-3">
    <summary class="cursor-pointer text-sm text-muted-foreground">{locale === "es" ? "Ver todas las capturas" : "View all screenshots"} ({images.length})</summary>
    <div class="mt-3 grid grid-cols-3 gap-2">{rest.map(image => <ProjectScreenshot image={image} locale={locale} thumbnail />)}</div>
  </details>}
</div>}
