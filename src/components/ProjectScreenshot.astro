---
import { Image, getImage } from "astro:assets"
import { projectAsset } from "@/lib/images"
import type { ProjectImage } from "@/lib/projects"
interface Props { image: ProjectImage; thumbnail?: boolean; locale: "es" | "en" }
const { image, thumbnail = false, locale } = Astro.props
const src = projectAsset(image.src)
const full = typeof src === "string" ? src : (await getImage({ src, width: Math.min(src.width, 1600), format: "webp", quality: 85 })).src
---
<a href={full} data-photo data-caption={image.alt} aria-label={(locale === "es" ? "Ampliar: " : "Enlarge: ") + image.alt} class:list={["block cursor-zoom-in rounded-xl focus-visible:outline", { "border bg-background": thumbnail }]}>
  <Image src={src} alt={image.alt} width={thumbnail ? 320 : 960} height={thumbnail ? 200 : 600} widths={thumbnail ? [160, 320] : [480, 960]} sizes={thumbnail ? "(max-width: 768px) 30vw, 160px" : "(max-width: 768px) 90vw, 600px"} format="webp" quality={80} loading="lazy" decoding="async" class={thumbnail ? "h-24 w-full object-contain" : "h-56 w-full rounded-xl object-contain sm:h-64"} />
</a>
