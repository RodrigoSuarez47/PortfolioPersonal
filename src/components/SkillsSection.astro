---
import { getCopy, type Locale } from "@/lib/i18n"
import TechnologyBadge from "./TechnologyBadge.astro"
import Section from "./Section.astro"
interface Props { locale?: Locale }
const { locale = "es" } = Astro.props
const t = getCopy(locale)
const categories = [
  { project: "mayorista-javier", evidence: { es: "Mayorista Javier: API, autenticación e inventario", en: "Mayorista Javier: API, authentication and inventory" }, title: "Backend e integraciones", skills: ["C#", "ASP.NET Core", "Entity Framework Core"] },
  { project: "catalogo-mayorista-javier", evidence: { es: "Catálogo Mayorista Javier: React y TypeScript", en: "Mayorista Javier catalog: React and TypeScript" }, title: "Frontend", skills: ["TypeScript", "JavaScript", "React", "Next.js", "Astro", "Vite", "Tailwind CSS"] },
  { project: "ratio-espina", evidence: { es: "Ratio: costos previstos, MongoDB y auditoría", en: "Ratio: planned costs, MongoDB and audit logging" }, title: "Datos", skills: ["PostgreSQL", "SQL Server", "MySQL", "MongoDB", "Python"] },
  { project: "fyv-traslados", evidence: { es: "FyV Traslados: Astro y despliegue en Vercel", en: "FyV Traslados: Astro and Vercel deployment" }, title: "Herramientas y despliegue", skills: ["Git", "GitHub", "Docker", "Azure", "Vercel", "Neon"] },
] as const
const additionalSkills = ["HTML", "CSS", "Java", "Firebase", "Bootstrap", "jQuery", "Redux", "Ionic Framework", "Kubernetes", "AWS", "Somee", "Windows Server", "GeneXus"]
---
<Section id="skills" eyebrow={t("Herramientas")} title={t("Un stack al servicio del problema")} description={t("Tecnologías que utilizo en desarrollo, integración y trabajo con datos. Los proyectos muestran cómo las aplico.")}>
      <div class="grid gap-5 sm:grid-cols-2">
        {categories.map((category) => (
          <div class="rounded-2xl border bg-card p-6">
            <h3 class="mb-5 text-lg font-semibold">{t(category.title)}</h3>
            <ul class="flex flex-wrap gap-2">{category.skills.map((skill) => <li><TechnologyBadge name={skill} /></li>)}</ul>
            <a class="text-link mt-5 block border-t pt-4 text-sm leading-relaxed text-muted-foreground" href={"#" + category.project}><span class="mb-1 block text-xs font-semibold uppercase tracking-wide">{t("Aplicado en proyectos")}</span>{category.evidence[locale]}</a>
          </div>
        ))}
      </div>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-muted-foreground">{locale === "es" ? "Integraciones y seguridad aplicadas en mis proyectos: diseño de APIs REST, autenticación con JWT, hashing de contraseñas con BCrypt.NET y notificaciones mediante Microsoft Graph. Mi formación también incluye Big Data." : "Integrations and security applied in my projects: REST API design, JWT authentication, password hashing with BCrypt.NET and notifications through Microsoft Graph. My training also includes Big Data."}</p>
      <details class="mt-6 rounded-2xl border p-6">
        <summary class="cursor-pointer text-sm font-medium">{t("Otras tecnologías y herramientas")}</summary>
        <ul class="flex flex-wrap gap-2 pt-4">{additionalSkills.map(skill => <li><TechnologyBadge name={skill} /></li>)}</ul>
      </details>
    </Section>
