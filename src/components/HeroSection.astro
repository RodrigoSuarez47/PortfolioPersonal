---
import Icon from "./Icon.astro"
import { getCopy, type Locale } from "@/lib/i18n"
import { site } from "@/lib/site"
import { getResume } from "@/lib/documents"
import { Image } from "astro:assets"
import portrait from "@/assets/profile-picture.png"
interface Props { locale?: Locale }
const { locale = "es" } = Astro.props
const t = getCopy(locale)

---
<section id="home" aria-labelledby="hero-title" class="hero-shell">
      <div class="page-container grid items-center gap-12 lg:grid-cols-[1.4fr_1fr]">
        <div class="space-y-7">
          <p class="eyebrow">{t("Desarrollo de software · Uruguay")}</p>
          <h1 id="hero-title" class="text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">{site.name}</h1>
          <p class="max-w-xl text-2xl font-medium leading-snug sm:text-3xl">{t("Desarrollador Full Stack")}</p>
          <div class="max-w-xl space-y-3 text-base leading-relaxed text-muted-foreground sm:text-lg"><p>{t("Analista en Tecnologías de la Información por Universidad ORT Uruguay.")}</p><p>{t("Desarrollo aplicaciones web y de escritorio a medida, desde el análisis y el diseño hasta el despliegue y el mantenimiento.")}</p></div>
          <div class="flex flex-wrap gap-3">
            <a class="button button-primary" href="#projects">{t("Explorar proyectos")}<Icon name="arrow" /></a>
            <a class="button button-outline" href="#contact"><Icon name="message" />{t("Hablemos")}</a>
          </div>
          <div class="flex flex-wrap gap-5 text-sm text-muted-foreground">
            <a class="text-link inline-flex items-center gap-2" href={site.github} target="_blank" rel="me noopener noreferrer"><Icon name="github" />GitHub<Icon name="external" class="h-3.5 w-3.5" /></a>
            <a class="text-link inline-flex items-center gap-2" href={site.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" />LinkedIn<Icon name="external" class="h-3.5 w-3.5" /></a>
            <a class="text-link inline-flex items-center gap-2" href={getResume(locale)} download><Icon name="download" />{t("Descargar CV")}</a>
          </div>
        </div>
        <div class="relative mx-auto w-full max-w-sm">
          <div class="relative aspect-[4/5] overflow-hidden rounded-3xl border bg-muted">
            <Image src={portrait} alt={locale === "en" ? "Rodrigo Suárez, software developer" : "Rodrigo Suárez, desarrollador de software"} width={384} height={480} widths={[384, 640, 768]} sizes="(max-width: 640px) calc(100vw - 48px), 384px" format="avif" quality={60} priority class="h-full w-full object-cover" />
          </div>
        </div>
      </div>
    </section>
