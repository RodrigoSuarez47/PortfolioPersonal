---
import Icon from "./Icon.astro"
import { getCopy, type Locale } from "@/lib/i18n"
import Section from "./Section.astro"
import { site } from "@/lib/site"
import { getResume } from "@/lib/documents"
interface Props { locale?: Locale }
const { locale = "es" } = Astro.props
const t = getCopy(locale)
const documents = [
  { title: "Currículum", href: getResume(locale) },
  { title: "Escolaridad", href: "/documents/Escolaridad_ATI.pdf" },
  { title: "Constancia de graduación", href: "/documents/Constancia_graduacion_ATI.pdf" },
] as const
---
<Section id="contact" eyebrow={t("Siguiente paso")} title={t("Conversemos sobre tu equipo o proyecto")} description={t("Abierto a oportunidades en desarrollo de software y trabajo con datos. Cuéntame el contexto, el desafío y qué necesitas construir.")}>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border bg-card p-6 sm:p-8">
          <h3 class="mb-3 text-xl font-semibold">{t("Contacto directo")}</h3>
          <p class="mb-6 text-sm leading-relaxed text-muted-foreground">{t("Por email para compartir detalles de una oportunidad o por WhatsApp para iniciar la conversación.")}</p>
          <div class="flex flex-wrap gap-3">
            <a class="button button-whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" />{t("Escribir por WhatsApp")}</a>
            <a class="button button-outline" href={site.email}><Icon name="mail" />{t("Enviar email")}</a>
          </div>
          <a href={site.email} class="text-link mt-5 inline-flex items-center gap-2 break-all text-sm text-muted-foreground"><Icon name="mail" />rodrisua1@hotmail.com</a>
        </div>
        <div class="rounded-2xl border bg-card p-6 sm:p-8">
          <h3 class="mb-3 text-xl font-semibold">{t("Perfil y formación")}</h3>
          <ul class="divide-y">{documents.map((document) => (
            <li><a class="document-link flex items-center justify-between gap-4 py-4 text-sm" href={document.href} download target="_blank" rel="noopener noreferrer"><span class="inline-flex items-center gap-3"><Icon name="file" class="text-primary" />{t(document.title)}</span><Icon name="download" class="text-primary" /></a></li>
          ))}</ul>
        </div>
      </div>
    </Section>
