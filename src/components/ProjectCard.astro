---
import Icon from "./Icon.astro"
import TechnologyBadge from "./TechnologyBadge.astro"
import { site } from "@/lib/site"
import Gallery from "./Gallery.astro"
import { getCopy, type Locale } from "@/lib/i18n"
import type { Project } from "@/lib/projects"
interface Props { project: Project; locale: Locale }
const { project, locale } = Astro.props
const t = getCopy(locale)
const { images } = project
const labels = { problem: "Problema", role: "Mi rol", decisions: "Decisiones técnicas", result: "Resultado" } as const
---
<article id={project.slug} class="project-card" data-wide={project.id === 5 || undefined} aria-labelledby={"project-" + project.id}>
  <div class="border-b bg-muted/40 p-4">
    {images.length > 0 ? <Gallery images={images} locale={locale} /> : (
      <div class="flex h-56 flex-col justify-between rounded-xl bg-primary/10 p-6 sm:h-64">
        <p class="eyebrow flex items-center gap-2"><Icon name="building" />{project.cover?.eyebrow ?? t("Web de servicios")}</p>
        <p class="text-3xl font-semibold tracking-tight">{project.title}</p>
        <p class="text-sm text-muted-foreground">{project.cover?.subtitle ?? t("Servicios · Tarifas · Contacto")}</p>
      </div>
    )}
  </div>
  <div class="flex flex-col gap-5 p-6 sm:p-8">
    <p class="eyebrow">{project.status}</p>
    <h3 id={"project-" + project.id} tabindex="-1" class="text-2xl font-semibold tracking-tight"><a href={"#" + project.slug} class="hover:text-primary" title={locale === "en" ? "Direct link to this project" : "Enlace directo a este proyecto"}>{project.title}</a></h3>
    <p class="text-sm leading-relaxed text-muted-foreground sm:text-base">{project.description}</p>
    <ul aria-label={t("Tecnologías principales")} class="flex flex-wrap gap-2">
      {project.technologies.slice(0, 4).map((tech) => <li><TechnologyBadge name={tech} compact /></li>)}
    </ul>
    <div class="flex flex-wrap gap-3">
      {project.demoUrl && <a class="button button-primary" href={project.demoUrl} target="_blank" rel="noopener noreferrer" aria-label={t("Visitar web") + ": " + project.title}>{t("Visitar web")}<Icon name="external" /></a>}
      {project.githubUrl && <a class="button button-outline" href={project.githubUrl} target="_blank" rel="noopener noreferrer" aria-label={t("Código") + ": " + project.title}><Icon name="github" />{t("Código")}</a>}
    </div>
    {project.delivery && <aside class="space-y-3 rounded-xl border border-primary/30 bg-primary/5 p-5" aria-label={project.delivery.title}><h4 class="font-semibold">{project.delivery.title}</h4><p class="text-sm leading-relaxed text-muted-foreground">{project.delivery.description}</p><a class="button button-outline" href={site.email + "?subject=" + encodeURIComponent(locale === "en" ? "Ratio — request installers" : "Ratio — solicitar instaladores")}><Icon name="download" />{project.delivery.cta}</a></aside>}
    <p class="rounded-xl bg-primary/10 p-4 font-semibold">{project.caseStudy.highlight}</p>
    <details data-case-study class="border-t pt-4">
      <summary class="cursor-pointer text-sm font-medium">{t("Caso de estudio")}</summary>
      <div class="space-y-4 pt-4">
        <dl class="space-y-4 text-sm leading-relaxed">
        {(Object.keys(labels) as (keyof typeof labels)[]).map((key) => <div>
          <dt class="mb-1 font-semibold">{t(labels[key])}</dt>
          <dd class="text-muted-foreground">{project.caseStudy[key]}</dd>
        </div>)}
        </dl>
        <p class="text-xs leading-relaxed text-muted-foreground">{project.caseStudy.evidence}</p>
      </div>
    </details>
    <details class="border-t pt-4">
      <summary class="cursor-pointer text-sm font-medium">{t("Detalles técnicos")}</summary>
      <div class="space-y-4 pt-4 text-sm leading-relaxed text-muted-foreground">
        <p>{project.longDescription}</p>
        <ul class="list-disc space-y-2 pl-5">{project.features.map((feature) => <li>{feature}</li>)}</ul>
        <p><strong class="text-foreground">{t("Stack completo: ")}</strong>{project.technologies.join(" · ")}</p>
      </div>
    </details>
  </div>
</article>
