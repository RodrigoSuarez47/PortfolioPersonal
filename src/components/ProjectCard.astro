---
import Icon from "./Icon.astro"
import { Image } from "astro:assets"
import { projectAsset } from "@/lib/images"
import TechnologyBadge from "./TechnologyBadge.astro"
import { site } from "@/lib/site"
import Gallery from "./Gallery.astro"
import { getCopy, type Locale } from "@/lib/i18n"
import type { Project } from "@/lib/projects"
interface Props { project: Project; locale: Locale }
const { project, locale } = Astro.props
const t = getCopy(locale)
const { images } = project
const statusIcon = project.status === "En construcción" || project.status === "In development" ? "construction" : "production"
const labels = { problem: "Problema", role: "Mi rol", decisions: "Decisiones técnicas", result: "Resultado" } as const
---
<article id={project.slug} class="project-card" data-featured={project.featured || undefined} aria-labelledby={"project-" + project.id}>
  <div class="project-media border-b bg-muted/40 p-4">
    {images.length > 0 ? <Gallery images={images} locale={locale} /> : (
      <div class="flex h-56 flex-col justify-between rounded-xl bg-primary/10 p-6 sm:h-64">
        <p class="eyebrow flex items-center gap-2"><Icon name={statusIcon} />{project.cover?.eyebrow ?? t("Web de servicios")}</p>
        {project.cover?.logo ? (project.cover.logo.endsWith(".svg") ? <img src={project.cover.logo} alt={project.title + " · logo"} width="144" height="144" loading="lazy" decoding="async" class="h-32 w-auto max-w-full object-contain sm:h-40" /> : <Image src={projectAsset(project.cover.logo) as import("astro").ImageMetadata} alt={project.title + " · logo"} width={420} height={229} format="webp" loading="lazy" class="h-32 w-auto max-w-full rounded-lg object-contain sm:h-40" />) : <p class="text-3xl font-semibold tracking-tight">{project.title}</p>}
        <p class="text-sm text-muted-foreground">{project.cover?.subtitle ?? t("Servicios · Tarifas · Contacto")}</p>
      </div>
    )}
  </div>
  <div class="project-content flex flex-col gap-5 p-6 sm:p-8">
    <div class="flex flex-wrap items-center gap-3"><p class="project-status eyebrow"><Icon name={statusIcon} class="h-4 w-4" />{project.status}</p>{project.featured && <span class="rounded-full border border-primary/30 px-3 py-1 text-xs font-medium text-primary">{t("Proyecto destacado")}</span>}</div>
    <h3 id={"project-" + project.id} tabindex="-1" class="text-2xl font-semibold tracking-tight"><a href={"#" + project.slug} class="hover:text-primary" title={locale === "en" ? "Direct link to this project" : "Enlace directo a este proyecto"}>{project.title}</a></h3>
    {project.collaborator && <p class="text-sm text-muted-foreground">{locale === "es" ? "Colaboro con " : "Collaboration with "}<a class="font-medium underline underline-offset-4 hover:text-primary" href={project.collaborator.url} target="_blank" rel="noopener noreferrer">{project.collaborator.name}<Icon name="external" class="ml-1 inline h-3.5 w-3.5" /></a></p>}
    <dl class="project-summary grid gap-4 text-sm leading-relaxed" data-project-summary>
      {(["problem", "role", "result"] as const).map(key => <div class:list={{ "project-outcome rounded-xl border border-primary/20 bg-primary/5 p-5": key === "result" && !project.delivery }}>
        <dt class="font-semibold">{key === "role" ? (locale === "en" ? "My contribution" : "Mi aporte") : t(labels[key])}</dt>
        <dd class="mt-2 max-w-prose text-base leading-relaxed text-muted-foreground">{project.caseStudy[key]}</dd>
      </div>)}
    </dl>
    <ul aria-label={t("Tecnologías principales")} class="flex flex-wrap gap-2">
      {project.technologies.slice(0, 4).map((tech) => <li><TechnologyBadge name={tech} compact /></li>)}
    </ul>
    <div class="flex flex-wrap gap-3">
      {project.demoUrl && <a class="button button-primary" href={project.demoUrl} target="_blank" rel="noopener noreferrer" aria-label={t("Visitar web") + ": " + project.title}>{t("Visitar web")}<Icon name="external" /></a>}
      {project.githubUrl && <a class="button button-outline" href={project.githubUrl} target="_blank" rel="noopener noreferrer" aria-label={t("Código") + ": " + project.title}><Icon name="github" />{t("Código")}</a>}
    </div>
    {project.delivery && <aside class="space-y-3 rounded-xl border border-primary/30 bg-primary/5 p-5" aria-label={project.delivery.title}><h4 class="text-lg font-semibold text-primary">{project.delivery.title}</h4><p class="max-w-prose text-base font-bold leading-relaxed text-primary">{project.delivery.description}</p><a class="button button-outline" href={site.email + "?subject=" + encodeURIComponent(locale === "en" ? "Ratio — request installers" : "Ratio — solicitar instaladores") + "&body=" + encodeURIComponent(locale === "en" ? "Hello, I visited your portfolio and I would be interested in trying Ratio. Could you share more information and the installers? Thank you!" : "Hola, revisé tu portfolio y me interesaría probar Ratio. ¿Podrías brindarme más información y los instaladores? ¡Gracias!")}><Icon name="download" />{project.delivery.cta}</a></aside>}
    <details data-case-study class="border-t pt-4">
      <summary class="cursor-pointer rounded-lg border bg-muted/40 px-4 py-3 text-sm font-semibold">{t("Ver decisiones técnicas y funcionalidades")}</summary>
      <div class="space-y-5 pt-5">
        <div class="space-y-2 text-sm leading-relaxed"><h4 class="font-semibold">{t("Decisiones técnicas")}</h4><p class="text-muted-foreground">{project.caseStudy.decisions}</p></div>
        <p class="text-sm text-muted-foreground">{project.longDescription}</p>
        <ul class="list-disc space-y-2 pl-5">{project.features.map((feature) => <li>{feature}</li>)}</ul>
        <p class="border-l-2 border-primary/40 pl-4 text-xs leading-relaxed text-muted-foreground">{project.caseStudy.evidence}</p>
        <div class="space-y-3"><h4 class="font-semibold text-foreground">{t("Stack completo: ")}</h4><ul aria-label={t("Stack completo: ")} class="flex flex-wrap gap-2">{project.technologies.map(tech => <li><TechnologyBadge name={tech} /></li>)}</ul></div>
      </div>
    </details>
  </div>
</article>
