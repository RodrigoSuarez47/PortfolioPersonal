---
import { getCopy, type Locale } from "@/lib/i18n"
import Icon from "./Icon.astro"
interface Props { locale?: Locale }
const { locale = "es" } = Astro.props
const t = getCopy(locale)

---
<footer class="border-t py-8">
      <div class="page-container flex flex-col items-center justify-between gap-4 text-sm text-muted-foreground md:flex-row">
        <p>© <span data-copyright-year>{new Date().getFullYear()}</span> Rodrigo Suárez. {t("Todos los derechos reservados.")}</p>
        <a href="https://www.google.com/maps/search/?api=1&amp;query=Montevideo%2C%20Uruguay" target="_blank" rel="noopener noreferrer" class="text-link flex items-center gap-2" aria-label={locale === "es" ? "Montevideo, Uruguay: abrir mapa" : "Montevideo, Uruguay: open map"}><Icon name="pin" />Montevideo, Uruguay</a>
        <a href="/llms.txt" class="text-link inline-flex items-center gap-2"><Icon name="code" />{t("Recursos para IA")}</a>
      </div>
    </footer>
