---
import { getCopy, type Locale } from "@/lib/i18n"
interface Props { locale?: Locale }
const { locale = "es" } = Astro.props
const t = getCopy(locale)

---
<footer class="border-t py-8">
      <div class="page-container flex flex-col items-center justify-between gap-4 text-sm text-muted-foreground md:flex-row">
        <p>© {new Date().getFullYear()} Rodrigo Suárez. {t("Todos los derechos reservados.")}</p>
        <p class="flex items-center gap-2">Montevideo, Uruguay</p>
        <a href="/llms.txt" class="underline underline-offset-4 hover:text-foreground">{t("Recursos para IA")}</a>
      </div>
    </footer>
