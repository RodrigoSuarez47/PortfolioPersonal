---
import { getCopy, type Locale } from "@/lib/i18n"
import Section from "./Section.astro"
interface Props { locale?: Locale }
const { locale = "es" } = Astro.props
const t = getCopy(locale)

---
<Section id="about" eyebrow={t("Perfil")} title={t("Tecnología con contexto de negocio")}>
      <div class="grid gap-8 text-base leading-relaxed text-muted-foreground md:grid-cols-2">
        <p>{t("Soy egresado de Analista en Tecnologías de la Información de Universidad ORT Uruguay. Trabajo desde el análisis de necesidades hasta la implementación y el despliegue, conectando desarrollo de software con procesos de negocio.")}</p>
        <p>{t("Desarrollo frontend y backend: aplicaciones web y de escritorio, APIs, seguridad de accesos, auditoría e integraciones. En Ratio implementé el módulo Gantt completo y modernicé la interfaz WPF; también trabajé en Excel e instaladores. Priorizo código claro, componentes reutilizables y soluciones mantenibles.")}</p>
      </div>
    </Section>
