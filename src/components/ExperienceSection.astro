---
import Section from "./Section.astro"
import { employment } from "@/data/profile.json"
import { getCopy, type Locale, type CopyKey } from "@/lib/i18n"
interface Props { locale?: Locale }
const { locale = "es" } = Astro.props
const t = getCopy(locale)
interface BackgroundItem { kind: CopyKey; title: CopyKey; description: CopyKey }
const background: BackgroundItem[] = [
  { kind: "Proyecto final de carrera", title: "Gestión de salas para Jaume & Sere", description: "Participación en el análisis y desarrollo de una solución de reservas con .NET, React, Active Directory y Microsoft Graph." },
  { kind: "Formación académica", title: "Analista en Tecnologías de la Información", description: "Universidad ORT Uruguay · Egresado" },
  { kind: "Formación complementaria", title: "Big Data y GeneXus", description: "Especialización en Big Data y formación como Analista GeneXus Jr." },
]
---
<Section id="experience" eyebrow={t("Recorrido")} title={t("Experiencia y formación")} description={t("Del análisis a la entrega")}>
      <div class="grid gap-5 md:grid-cols-2">
        {employment.map(item => <article class="space-y-3 rounded-2xl border bg-card p-6">
          <p class="eyebrow">{t("Experiencia laboral")} · {item.organization}</p>
          <h3 class="text-lg font-semibold">{item.role[locale]}</h3>
          <p class="text-sm font-medium text-primary">{item.since} - {item.until ?? (locale === "es" ? "Actualidad" : "Present")}</p>
          <p class="text-sm leading-relaxed text-muted-foreground">{item.description[locale]}</p>
        </article>)}
        {background.map((item) => (
          <article class="space-y-3 rounded-2xl border bg-card p-6">
            <p class="eyebrow">{t(item.kind)}</p>
            <h3 class="text-lg font-semibold">{t(item.title)}</h3>
            <p class="text-sm leading-relaxed text-muted-foreground">{t(item.description)}</p>
          </article>
        ))}
      </div>
    </Section>
