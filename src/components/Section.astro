---
interface Props { id: string; eyebrow: string; title: string; description?: string }
const { id, eyebrow, title, description } = Astro.props
---
<section id={id} aria-labelledby={id + "-title"} class="section-shell">
  <div class="page-container">
    <header class="section-heading">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={id + "-title"} class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
      {description && <p class="max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">{description}</p>}
    </header>
    <slot />
  </div>
</section>
