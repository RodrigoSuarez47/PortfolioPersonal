---
import { site } from "@/lib/site"
import { getSeo } from "@/lib/seo"
import type { Locale } from "@/lib/i18n"
import "@/styles/global.css"
import { getImage } from "astro:assets"
import socialImage from "@/assets/og-image.png"
interface Props { locale: Locale }
const { locale } = Astro.props
const { title, description, language, url, graph } = getSeo(locale)
const social = await getImage({ src: socialImage, width: 1200, format: "jpeg", quality: 80 })
---
<!doctype html>
<html lang={language} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="color-scheme" content="dark light" />
    <meta name="is-agentic-site-type" content="business" />
    <link rel="alternate" type="text/markdown" href="/portfolio.md" title="Portfolio — Markdown (ES/EN)" />
    <link rel="alternate" type="application/json" href="/portfolio.json" title="Portfolio — structured public data (ES/EN)" />
    <link rel="help" type="text/plain" href="/llms.txt" title="AI navigation guide" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="es-UY" href={site.url + "/"} />
    <link rel="alternate" hreflang="en" href={site.url + "/en"} />
    <link rel="alternate" hreflang="x-default" href={site.url + "/"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "es_UY"} />
    <meta property="og:locale:alternate" content={locale === "en" ? "es_UY" : "en_US"} />
    <meta property="og:image" content={site.url + social.src} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={site.url + social.src} />
    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, "\\u003c")} />
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        document.documentElement.classList.toggle("dark", theme !== "light");
      } catch {}
    </script>
  </head>
  <body>
    <slot />
    <dialog data-lightbox class="lightbox" aria-labelledby="lightbox-title">
      <div class="flex items-center justify-between gap-4">
        <h2 id="lightbox-title" class="text-base font-semibold"></h2>
        <form method="dialog"><button class="button button-outline" aria-label={locale === "en" ? "Close image" : "Cerrar imagen"}>✕</button></form>
      </div>
      <img data-lightbox-image alt="" width="1600" height="1000" class="lightbox-image" />
      <div class="flex items-center justify-between gap-3">
        <button type="button" class="button button-outline" data-lightbox-prev>{locale === "en" ? "Previous" : "Anterior"}</button>
        <p data-lightbox-counter class="text-sm text-muted-foreground" aria-live="polite"></p>
        <button type="button" class="button button-outline" data-lightbox-next>{locale === "en" ? "Next" : "Siguiente"}</button>
      </div>
    </dialog>
    <script>
      import "../scripts/interactions"
      import "../scripts/agent-tools"
      import { inject } from "@vercel/analytics"
      inject()
    </script>
  </body>
</html>
